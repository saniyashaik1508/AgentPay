# Database (defaults to local SQLite if unset — swap to Postgres DSN for production)
DATABASE_URL=sqlite:///./agentpay.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agentpay

# Razorpay Test Mode credentials — get these from https://dashboard.razorpay.com (Test Mode)
# If left unset, AgentPay automatically falls back to a clearly-labeled mock payment adapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Anthropic API key — enables the real LLM tool-calling shopping agent.
# If unset, a deterministic non-LLM fallback agent is used so demos still run.
ANTHROPIC_API_KEY=

# HMAC pepper for hashing agent authentication secrets (set a real random value in production)
AGENTPAY_SECRET_PEPPER=dev-only-pepper-change-in-prod
